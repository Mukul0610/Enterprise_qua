# ==============================================================================
# PROCUCEV ENTERPRISE (QUA AI 2.0) - ENVIRONMENT VARIABLES EXAMPLE
# ==============================================================================
# Copy this file to .env or configure in your deployment orchestrator / CI/CD pipeline.
# Do NOT include real production secrets, passwords, or private keys in this file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION RUNTIME & ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
CI=false

# ------------------------------------------------------------------------------
# 2. BACKEND SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=4000
AUTO_START_SERVER=true

# ------------------------------------------------------------------------------
# 3. DATABASE (Neon PostgreSQL) — the only datastore
# ------------------------------------------------------------------------------
# One connection backs everything: the `user` / `role` / `organization` tables
# that authenticate logins, the `category_division` procurement taxonomy, and
# every domain record (vendors, RFQs, evaluations, buyer accounts, catalogue,
# AI feed, audit logs).
#
# The MYSQL_* / IDENTITY_DB_* settings that used to be here are gone: the second
# pool against a shared MySQL identity schema has been removed along with the
# mysql2 driver.
#
# Without DATABASE_URL the app still starts, but every data-backed request fails
# with a descriptive error — it no longer falls back to in-memory seed data.
# Run `npm run db:migrate --prefix backend` once to create the schema. Nothing is
# seeded, so create a first sign-in account with:
#   npm run create-buyer --prefix backend -- --email a@b.com --phone 9876543210 --password 'Secret@123'
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
# Idle clients are released this quickly because a managed/serverless provider
# bills for compute for as long as a connection is held open.
DATABASE_IDLE_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 3b. SESSION SIGNING
# ------------------------------------------------------------------------------
# Signs and verifies session tokens. Required in production — the process refuses
# to start without it. Outside production a random key is generated per process,
# so sessions stop verifying after a restart until this is set. There is no
# hardcoded fallback key any more.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# Query Cache & Profiling Configuration
QUERY_CACHE_TTL_MS=60000
QUERY_CACHE_MAX_ENTRIES=500
SLOW_QUERY_THRESHOLD_MS=200

# ------------------------------------------------------------------------------
# 3c. CLOUDFLARE R2 (RFQ attachment storage, S3-compatible)
# ------------------------------------------------------------------------------
# Leave unset and uploads fail closed rather than silently falling back to
# local disk.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional override; derived from R2_ACCOUNT_ID by default.
R2_ENDPOINT=
# Object key prefix within the bucket.
RFQ_ATTACHMENT_DIR=uploads/rfq-attachments
RFQ_ATTACHMENT_MAX_BYTES=10485760
RFQ_ATTACHMENT_MAX_PER_RFQ=10

# ------------------------------------------------------------------------------
# 4. STRUCTURED LOGGING CONFIGURATION
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
LOG_MAX_SIZE_BYTES=10485760

# ------------------------------------------------------------------------------
# 5. AES ENCRYPTION & CRYPTOGRAPHY CONFIGURATION
# ------------------------------------------------------------------------------
# Master 256-bit encryption key (64 hex characters or 32-byte string)
AES_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AES_SECRET_KEY=enterprise-qua-ai-master-secret-key-placeholder-32b
AES_CIPHER_ALGORITHM=aes-256-gcm

# ------------------------------------------------------------------------------
# 6. FRONTEND & API GATEWAY CONFIGURATION
# ------------------------------------------------------------------------------
NODE_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_GRAPHQL_URL=/api/graphql
NEXT_PUBLIC_APP_ENV=development


# ------------------------------------------------------------------------------
# 7. GEMINI AI — RFQ DOCUMENT LINE-ITEM EXTRACTION
# ------------------------------------------------------------------------------
# Powers AI extraction in the buyer ingestion wizard (Step 2). The key is read
# server-side only and is never sent to the browser. Without it the wizard still
# works: extraction reports NOT_CONFIGURED and the buyer adds line items manually.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Override these only to change model or endpoint.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_PRIMARY_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-flash-lite-latest,gemini-3.8-flash,gemini-3.6-flash,gemini-3.7-flash
GEMINI_REQUEST_TIMEOUT_MS=30000
# Ceiling for the whole model chain, not one attempt. Extraction is answered
# inside a browser request, so the walk must finish while a client is listening.
GEMINI_TOTAL_BUDGET_MS=60000
# Remaining budget below which a further model is not attempted.
GEMINI_MIN_ATTEMPT_MS=3000
GEMINI_MAX_DOCUMENT_BYTES=26214400
GEMINI_MAX_DOCUMENT_TEXT_CHARS=300000

# SEED_DEMO_RFQS is gone. There is no seed data left to preload — records come
# from real use, and an empty database reports itself as empty.

# ------------------------------------------------------------------------------

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "procucev-enterprise-backend",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": true
    }
  },
  "main": "src/worker.mjs",
  "alias": {
    "iconv-lite": "./src/workerShims/iconvLiteShim.js",
    "pdfkit": "./node_modules/pdfkit/js/pdfkit.js"
  },
  "vars": {
    "NODE_ENV": "production",
    "WHATSAPP_USERNAME": "ProcucevWapp1",
    "WHATSAPP_PASSWORD": "ProcucevWapp@123",
    "WHATSAPP_FROM_NUMBER": "919606848835",
    "WHATSAPP_BASE_URL": "https://media.sendmsg.in",
    "WHATSAPP_TEMPLATE_BASE_URL": "https://wsapi.sendmsg.in",
    "WHATSAPP_TEMPLATE_RFQ_NOTIFICATION": "rfq_reminder_notification_v2",
    "WHATSAPP_SUPPORT_NUMBER": "+919606848835",
    "SMS_GATEWAY_URL": "https://sms.sendmsg.in/datasend",
    "SMS_GATEWAY_USER": "Procucev_OTP",
    "SMS_GATEWAY_RFQ_USER": "ProcucevWapp1",
    "SMS_GATEWAY_RFQ_PASS": "ProcucevWapp@123",
    "SMS_GATEWAY_PASS": "TzlzyMcFEZRF",
    "SMS_GATEWAY_SENDER": "PROCUC",
    "SMS_GATEWAY_SMSGID": "1102294821",
    "SMS_GATEWAY_RFQ_SMSGID": "1777179076323440961",
    "SMS_GATEWAY_BUYER_UNLOCKED_SMSGID": "1777179138668879258",
    "PUBLIC_FRONTEND_URL": "https://procucev-enterprise-frontend.srinivas-mukku.workers.dev",
    "ZOHO_MODE": "live",
    "ZOHO_CLIENT_ID": "1000.TG6BL83MLH7SLYFK4LLUWH6Y6NCPOD",
    "ZOHO_PAYMENTS_ACCOUNT_ID": "60045604493",
    "ZOHO_PAYMENTS_BASE_URL": "https://payments.zoho.in/api/v1",
    "ZOHO_OAUTH_TOKEN_URL": "https://accounts.zoho.in/oauth/v2/token",
    "ZOHO_PAYMENTS_RETURN_URL_BASE": "https://equa.procucev.com",
    "ZOHO_RECONCILIATION_ENABLED": "true",
    "ENTERPRISE_INQUIRY_NOTIFICATION_EMAIL": "info@procucev.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "enterprise-qua-d1",
      "database_id": "63af6c6f-3606-4afa-b0c7-9f9db6296d61"
    }
  ],
  // Native R2 binding — used in place of the @aws-sdk/client-s3 path (see
  // r2Client.js's getBinding()) when running on Workers. The S3Client
  // constructor throws `emitWarningIfUnsupportedVersion$1 is not a function`
  // there: esbuild resolves @aws-sdk/core/client's "browser" package.json
  // export condition instead of "node" even with nodejs_compat enabled, and
  // that browser build's no-op stub for this function doesn't survive the
  // bundle intact. Rather than fighting the SDK's export resolution, this
  // uses Cloudflare's own recommended approach (see the Workers best-
  // practices doc: "Use bindings for Cloudflare services, not REST APIs").
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "procucec-dev"
    }
  ],
  // Drives the scheduled() export in worker.mjs — Cloudflare's replacement
  // for server.js's setInterval-based startPolling() (Node/Render only,
  // never called here). Each entry's string must match EMAIL_GATEWAY_CRON /
  // ZOHO_RECONCILIATION_CRON in worker.mjs exactly, since that's how
  // scheduled() tells the two triggers apart on controller.cron.
  "triggers": {
    "crons": [
      "* * * * *",
      "*/10 * * * *"
    ]
  },
  "env": {
    "dev": {
      "name": "procucev-enterprise-backend",
      "vars": {
        "NODE_ENV": "development",
        "WHATSAPP_USERNAME": "ProcucevWapp1",
        "WHATSAPP_PASSWORD": "ProcucevWapp@123",
        "WHATSAPP_FROM_NUMBER": "919606848835",
        "WHATSAPP_BASE_URL": "https://media.sendmsg.in",
        "WHATSAPP_TEMPLATE_BASE_URL": "https://wsapi.sendmsg.in",
        "WHATSAPP_TEMPLATE_RFQ_NOTIFICATION": "rfq_reminder_notification_v2",
        "WHATSAPP_SUPPORT_NUMBER": "+919606848835",

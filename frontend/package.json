{
  "name": "procucev-enterprise-frontend",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --forceExit --maxWorkers=2",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit --maxWorkers=2 && node scripts/verify-coverage.cjs",
    "check:coverage": "node scripts/verify-coverage.cjs",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "cloudflare:build": "npm run build:vinext"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.9",
    "lucide-react": "^0.453.0",
    "next": "^14.2.35",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "vinext": "^1.0.0-beta.11",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.57.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "autoprefixer": "^10.5.4",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.2",
    "vite": "^8.3.0",
    "whatwg-fetch": "^3.6.20",
    "wrangler": "^4.136.1"
  },
  "type": "module"
}
